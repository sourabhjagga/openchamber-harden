{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Kyiv",
  "schedule": [
    "* 1 1 * *"
  ],
  "minimumReleaseAge": "1 day",
  "dependencyDashboard": true,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "customManagers": [
    {
      "description": "Track Node.js major in Dockerfile ARG (node datasource, major-only versioning)",
      "customType": "regex",
      "fileMatch": [
        "(^|/)Dockerfile$"
      ],
      "matchStrings": [
        "ARG NODE_VERSION=(?<currentValue>\\d+)"
      ],
      "depNameTemplate": "node",
      "datasourceTemplate": "node",
      "versioningTemplate": "major"
    }
  ],
  "packageRules": [
    {
      "description": "Group non-major development dependency updates",
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "development dependencies"
    },
    {
      "description": "Auto-merge all non-major updates so latest stable flows into main",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "lockFileMaintenance"
      ],
      "automerge": true
    },
    {
      "description": "androidx.core 1.17+ needs compileSdk 36+ (1.19 needs 37 and AGP 9.1); lift together with the Android SDK baseline",
      "matchPackageNames": [
        "androidx.core:core"
      ],
      "allowedVersions": "<1.17.0"
    }
  ],
  "forkProcessing": "enabled"
}
